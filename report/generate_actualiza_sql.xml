<?xml version="1.0" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sql_actualiza_execute_wizard">
            <field name="name">Actualiza Empleado</field>
            <field name="model">sql_process_actualiza.sql_actualiza_execute</field>
            <field name="arch" type="xml">
                <form string="Generate file">
                    <field invisible="1" name="state"/>
                    <field name="name" invisible="1"/>
					<group states="choose" string="Ingrese filtro para Proceso">
                		<group string="Indique Empleado">
                    		<field name="employee_id" options="{'no_create': True,'no_quick_create':True,'no_create_edit':True }" required="0"/>
                		</group>
                		<group string="Tipo de Planilla">
                    		<field name="categoria_employee_id" options="{'no_create': True,'no_quick_create':True,'no_create_edit':True }" required="0"/>
                		</group>
                    </group>
                    <group states="choose" string="Ingrese Rango de Fecha">
                        <field name="fecha_desde" required="1"/>
                        <field name="fecha_hasta" required="1"/>
                    </group>
                    <group states="choose">
	                	<group string="Marque si desea actualizar">
	                        <field name="actualiza" required="1"/>
	                	</group>
	                    <group string="Marque si desa imprimir">
	                        <field name="imprime" required="1"/>
	                	</group>
                	</group>
                    <div states="get">
                        <h2>Generacion completa</h2>
                        <p>Click aqui para abrir: <field name="data" readonly="1" filename="name"/></p>
                    </div>
                    <footer states="choose">
                        <button name="generate_file" string="Ejecutar" type="object" class="oe_highlight"/>
                        or
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                    <footer states="get">
                        <button special="cancel" string="Close" type="object"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="sql_actualiza_execute_action" model="ir.actions.act_window">
            <field name="name">SQL Actualiza Empleado</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sql_process_actualiza.sql_actualiza_execute</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            name="Actualiza Empleado"
            action="sql_actualiza_execute_action"
            id="sql_actualiza_execute_menu"
            parent="hr_payroll.menu_hr_payroll_configuration"
            sequence="300"
        />

    </data>
</odoo>